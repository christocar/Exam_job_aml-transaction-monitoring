# Copy this file to .env and fill in your own values. Never commit .env.

# --- GCP / BigQuery ---
# GCP project ID (BigQuery sandbox)
# GCP_PROJECT_ID=
# BigQuery dataset location, e.g. EU or US
# BQ_LOCATION=
# Path to the service account key file (keep it outside the repo or gitignored)
# GOOGLE_APPLICATION_CREDENTIALS=

# --- dlt ---
# Source/destination settings for ingestion
# DLT_DESTINATION=

# --- dbt ---
# DBT_TARGET=

# --- Dagster ---
# DAGSTER_HOME=

# --- API / Kong gateway ---
# API_HOST=
# API_PORT=
# KONG_API_KEY=

# --- Streamlit dashboard ---
# DASHBOARD_API_URL=
